{
  "name": "maltbiscuit",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22.23.4",
    "bun": ">=1.3.14"
  },
  "workspaces": [
    "website"
  ],
  "scripts": {
    "dev": "sst dev",
    "deploy": "bun run site:build && sst deploy",
    "deploy:ci": "bun --cwd website build:fast && sst deploy --stage production",
    "remove": "sst remove",
    "site:dev": "bun --cwd website dev",
    "site:tina": "bun --cwd website tina",
    "site:build": "bun --cwd website build",
    "lint": "bun --cwd website lint",
    "format": "bun --cwd website format",
    "format:check": "bun --cwd website format:check"
  },
  "devDependencies": {
    "sst": "^4.17.2"
  },
  "overrides": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3"
  }
}
