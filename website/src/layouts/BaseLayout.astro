---
import { ClientRouter } from 'astro:transitions';

import SiteDialogs from '../components/dialogs/SiteDialogs';
import Footer from '../components/Footer.astro';
import Logo from '../components/Logo.astro';
import { settings } from '../lib/settings';

interface Props {
  title: string;
  description: string;
  /** Float the nav over the page, for full-page heroes. */
  overlayNav?: boolean;
}
const { title, description, overlayNav = false } = Astro.props;

// Details for the Contact dialog: phone from Site settings, Instagram from the footer's.
const insta = settings.footer?.instagram?.handle?.replace(/^@/, '').trim();
const contact = {
  phone: settings.contact?.phone?.trim() || undefined,
  instagramHandle: insta || undefined,
  instagramHref:
    settings.footer?.instagram?.href?.trim() || (insta ? `https://www.instagram.com/${insta}/` : undefined),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Brand font for the "Malt Biscuit" name (Eracake, via CDNFonts). -->
    <link rel="preconnect" href="https://fonts.cdnfonts.com" crossorigin />
    <link href="https://fonts.cdnfonts.com/css/eracake" rel="stylesheet" />
    {
      /* Genty demo font: personal-use licence, no webfont embedding. Dev server
         only, never in a production build; the files are gitignored. */
      import.meta.env.DEV && (
        <style
          set:html={`@font-face{font-family:'Genty Demo';src:url('/fonts/genty/GentyDemo-Regular.otf') format('opentype');font-display:swap}`}
        />
      )
    }
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <nav class:list={["site-nav", { overlay: overlayNav }]} aria-label="Main">
      <a href="/" class="wordmark" aria-label="Malt Biscuit, home"><Logo variant="mark" size={52} background="#fff02e" /></a>
      <div class="nav-actions">
        <a href="/#contact" class="nav-link" data-contact>Contact</a>
        <a href="/#book" class="nav-btn nav-cta" data-booking>Book Now</a>
      </div>
    </nav>
    <slot />
    <Footer />
    <!-- Booking and Contact dialogs, opened by [data-booking] / [data-contact]. -->
    <SiteDialogs client:idle contact={contact} />
  </body>
</html>

<style is:global>
  /* Genty Bold Rounded (Flavortype). Commercial licence required: the free
     download is personal use only. Put the licensed file in public/fonts as
     genty.woff2 (best), genty.otf or genty.ttf; until then the hero falls
     back to Eracake. */
  @font-face {
    font-family: 'Genty';
    src:
      url('/fonts/genty.woff2') format('woff2'),
      url('/fonts/genty.otf') format('opentype'),
      url('/fonts/genty.ttf') format('truetype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  :root {
    /* How far the main content panel rides up over the bottom of the hero. */
    --hero-overlap: clamp(4.5rem, 14svh, 9rem);
    --gutter: clamp(1rem, 4vw, 2.5rem);
    /* Display font for the "Malt Biscuit" name in the hero: Genty (licensed
       file, @font-face below), then the Genty demo (dev server only, see
       <head>), then Eracake (CDNFonts) everywhere else. */
    --font-brand: 'Genty', 'Genty Demo', 'Eracake', 'Cooper Black', Georgia, serif;
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
    color: #000000;
    background: #f5f5f5;
  }
  * { box-sizing: border-box; }
  /* Match MUI's CssBaseline so pages with and without a MUI island render text
     identically. */
  html {
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  body { min-width: 320px; margin: 0; font-family: inherit; line-height: 1.5; }
  a { color: inherit; }

  .site-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: 1120px;
    height: 56px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .site-nav a { text-decoration: none; }
  .site-nav .wordmark { display: inline-flex; border-radius: 999px; }

  .site-nav .nav-actions { display: flex; align-items: center; gap: 1.25rem; }
  /* Contact: pink text link with a black outline and hard offset shadow, so
     it reads over both the white and black zebra stripes. */
  .site-nav .nav-link {
    display: inline-block;
    color: #ff35b3;
    font-size: 1.0625rem;
    font-weight: 900;
    -webkit-text-stroke: 1.5px #000;
    paint-order: stroke fill;
    text-shadow: 2px 2px 0 #000;
    transition: transform 0.15s ease, text-shadow 0.15s ease;
  }
  .site-nav .nav-link:hover { transform: translate(-1px, -1px); text-shadow: 3px 3px 0 #000; }
  .site-nav .nav-link:active { transform: translate(1px, 1px); text-shadow: 1px 1px 0 #000; }
  .site-nav .nav-link:focus-visible { outline: 3px solid #4eb6f7; outline-offset: 3px; border-radius: 4px; }
  /* Nav pills: black ring, bold label. */
  .site-nav .nav-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1.125rem;
    border: var(--frame-width) solid var(--frame-color);
    border-radius: 999px;
    color: #000000;
    font-size: 0.9375rem;
    font-weight: 800;
    white-space: nowrap;
  }
  .site-nav .nav-btn:focus-visible { outline: 3px solid #4eb6f7; outline-offset: 3px; }
  /* Book Now: pink, small hard offset shadow (like .cta). */
  .site-nav .nav-cta {
    background: #ff35b3;
    box-shadow: 3px 3px 0 var(--frame-color);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .site-nav .nav-cta:hover { transform: translate(-1px, -1px); box-shadow: 4px 4px 0 var(--frame-color); }
  .site-nav .nav-cta:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 var(--frame-color); }
  @media (prefers-reduced-motion: reduce) { .site-nav .nav-btn, .site-nav .nav-link { transition: none; } }

  /* Overlay nav: floats over a full-page hero. */
  .site-nav.overlay {
    position: absolute;
    inset: 0 0 auto;
    z-index: 10;
    max-width: none;
    height: calc(72px + env(safe-area-inset-top, 0px));
    padding-top: env(safe-area-inset-top, 0px);
  }

  /* Frame: thick black border, rounded corners and a hard offset shadow.
     Add class="frame" to any element to reuse it (the hero card and the main
     panel both do). Override the variables on an element to tweak one frame,
     e.g. style="--frame-offset: 6px". */
  :root {
    --frame-color: #000000;
    --frame-width: 3px;
    --frame-radius: 28px;
    --frame-offset: 12px;
  }
  @media (max-width: 600px) {
    :root { --frame-radius: 22px; --frame-offset: 8px; }
  }
  .frame {
    border: var(--frame-width) solid var(--frame-color);
    border-radius: var(--frame-radius);
    box-shadow: var(--frame-offset) var(--frame-offset) 0 var(--frame-color);
  }
  /* Border and corners only, no offset shadow: class="frame frame-flat". */
  .frame.frame-flat {
    box-shadow: none;
  }

  /* The "Malt Biscuit" name, wherever it appears. Eracake has one weight. */
  .font-brand {
    font-family: var(--font-brand);
    font-weight: 400;
    letter-spacing: 0;
  }

  /* Shared building blocks for content sections (src/components/sections). */
  .tag {
    display: inline-block;
    margin: 0 0 1.25rem;
    padding: 0.3rem 0.875rem;
    border: var(--frame-width) solid var(--frame-color);
    border-radius: 999px;
    background: #FFF02E;
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .section-title {
    margin: 0;
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .section-intro {
    max-width: 34rem;
    margin: 1.25rem 0 0;
    font-size: 1.125rem;
    line-height: 1.65;
    color: #525252;
  }
  /* Round icon in a black ring; set the fill with style="--icon-bg: …". */
  .icon-badge {
    display: grid;
    place-items: center;
    flex: none;
    width: 3rem;
    height: 3rem;
    border: var(--frame-width) solid var(--frame-color);
    border-radius: 999px;
    background: var(--icon-bg, #fff);
  }
  .icon-badge svg { width: 1.375rem; height: 1.375rem; fill: #000000; }

  /* Long-form text from Tina's rich-text body fields. */
  .prose { font-size: 1.0625rem; line-height: 1.7; }
  .prose > :first-child { margin-top: 0; }
  .prose > :last-child { margin-bottom: 0; }
  .prose h2 { margin: 2.75rem 0 0.75rem; font-size: clamp(1.5rem, 3vw, 1.875rem); line-height: 1.2; letter-spacing: -0.02em; }
  .prose h3 { margin: 2rem 0 0.5rem; font-size: 1.25rem; line-height: 1.3; }
  .prose p, .prose ul, .prose ol { margin: 0 0 1.125rem; }
  .prose ul, .prose ol { padding-left: 1.25rem; }
  .prose li + li { margin-top: 0.375rem; }
  .prose a { color: #000000; text-decoration-color: #FF35B3; text-decoration-thickness: 2px; text-underline-offset: 3px; }
  .prose :not(pre) > code { padding: 0.1em 0.35em; border-radius: 6px; background: rgb(0 0 0 / 0.07); font-size: 0.9em; }
  .prose pre { margin: 0 0 1.25rem; padding: 1rem 1.25rem; border-radius: 12px; overflow-x: auto; font-size: 0.875rem; }

  /* Islands are layout-transparent so their markup sits directly in the flow. */
  astro-island { display: contents; }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation: none !important;
    }
  }
</style>
