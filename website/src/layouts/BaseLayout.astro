---
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;

const nav = [
  { href: '/', label: 'Home' },
  { href: '/brand', label: 'Brand' },
];
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <nav class="site-nav" aria-label="Main">
      <a href="/" class="wordmark">maltbiscuit</a>
      <ul>
        {nav.map(({ href, label }) => (
          <li><a href={href} aria-current={current === href ? 'page' : undefined}>{label}</a></li>
        ))}
      </ul>
    </nav>
    <slot />
  </body>
</html>

<style is:global>
  :root { font-family: Inter, ui-sans-serif, system-ui, sans-serif; color: #09203B; background: #f5f8fb; }
  * { box-sizing: border-box; }
  /* Match MUI's CssBaseline so pages with and without a MUI island render text
     identically. */
  html {
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  body { min-width: 320px; margin: 0; font-family: inherit; line-height: 1.5; }
  a { color: inherit; }

  .site-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: 1120px;
    height: 56px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .site-nav ul { display: flex; gap: 0.25rem; margin: 0; padding: 0; list-style: none; }
  .site-nav a { text-decoration: none; }
  .site-nav .wordmark { font-weight: 800; letter-spacing: -0.02em; }
  .site-nav li a { padding: 0.375rem 0.75rem; border-radius: 999px; font-size: 0.9375rem; }
  .site-nav li a:hover { background: rgb(9 32 59 / 0.06); }
  .site-nav li a[aria-current='page'] { background: #09203B; color: #fff; }

  /* Islands are layout-transparent so their markup sits directly in the flow. */
  astro-island { display: contents; }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation: none !important;
    }
  }
</style>
