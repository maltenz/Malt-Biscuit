---
// Malt Biscuit logo, drawn inline in `currentColor` so it takes the text colour
// of wherever it sits (black in the nav, white in the footer).
//
// Variants:
// - `badge` (./MB_Black.svg): the full logo, ring, flourishes and script name.
//   Detailed; use it large (roughly 100px and up).
// - `mark` (./MB_Mark.svg): "MB" monogram in a heavy ring, with the M and B
//   lifted from the badge. Use it small: nav, favicon, avatars.
//
// Pass `background` to fill inside the ring, e.g. so it reads over the hero's
// zebra stripes.
import badge from './MB_Black.svg?raw';
import mark from './MB_Mark.svg?raw';

interface Props {
  variant?: 'badge' | 'mark';
  /** Rendered width in px; height follows the logo's aspect ratio. */
  size?: number;
  /** Fill colour inside the ring. Transparent when omitted. */
  background?: string;
  class?: string;
}
const { variant = 'badge', size = 40, background, class: className } = Astro.props;

// viewBox size, and the radius of the fill disc behind the ring.
const SOURCES = {
  badge: { raw: badge, w: 1672, h: 1668, r: 815 },
  mark: { raw: mark, w: 1000, h: 1000, r: 480 },
} as const;
const { raw, w, h, r } = SOURCES[variant];

// Inner markup of the source SVG, recoloured to follow the text colour.
const inner = raw
  .replace(/^[\s\S]*?<svg[^>]*>/, '')
  .replace(/<\/svg>\s*$/, '')
  .replaceAll('"black"', '"currentColor"');
---

<svg
  class:list={['logo', className]}
  width={size}
  height={Math.round((size * h) / w)}
  viewBox={`0 0 ${w} ${h}`}
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  {background && <circle cx={w / 2} cy={h / 2} r={r} fill={background} />}
  <Fragment set:html={inner} />
</svg>

<style>
  .logo {
    display: block;
    flex: none;
  }
</style>
