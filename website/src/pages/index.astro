---
import Welcome from '../components/Welcome';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPage } from '../lib/content';

const home = getPage('home');
const title = home?.title ?? 'maltbiscuit';
const description = home?.description ?? 'An Astro + TinaCMS + MUI starter on Cloudflare.';
---

<BaseLayout title={title} description={description}>
  <main>
    <Welcome title={title} description={description} client:load />
  </main>
</BaseLayout>

<style>
  main {
    display: grid;
    place-items: center;
    min-height: calc(100dvh - 56px);
    padding: 1.5rem;
  }
</style>
