---
import BrandPalette from '../components/BrandPalette';
import Hero from '../components/Hero';
import PagePanel from '../components/PagePanel.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPage } from '../lib/content';

// Title, description, usage notes and documentation come from Tina
// (content/pages/brand.md); colour values come from the MUI theme.
// Same full-page hero as the home page, then the palette and docs in a panel.
const page = getPage('brand');
if (!page) {
  throw new Error('Missing content/pages/brand.md');
}
const { title, description, swatchNotes, Content } = page;
---

<BaseLayout title={`${title} · Malt Biscuit`} description={description} overlayNav>
  <main>
    <Hero title={title} description={description} profile={false} />
    <PagePanel>
      <BrandPalette notes={swatchNotes} client:load />

      <article class="docs prose">
        <Content />
      </article>
    </PagePanel>
  </main>
</BaseLayout>

<style>
  .docs {
    max-width: 720px;
    margin-top: 4rem;
  }
</style>
