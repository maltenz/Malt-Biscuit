---
import BrandPalette from '../components/BrandPalette';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPage } from '../lib/content';

// Title, description, usage notes and documentation come from Tina
// (content/pages/brand.md); colour values come from the MUI theme.
const page = getPage('brand');
if (!page) {
  throw new Error('Missing content/pages/brand.md');
}
const { title, description, swatchNotes, Content } = page;
---

<BaseLayout title={`${title} · maltbiscuit`} description={description}>
  <main>
    <header>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
    </header>

    <BrandPalette notes={swatchNotes} client:load />

    <article class="docs">
      <Content />
    </article>
  </main>
</BaseLayout>

<style>
  main {
    max-width: 1120px;
    margin: 0 auto;
    padding: 2rem 1.5rem 5rem;
  }
  h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: -0.02em;
  }
  .lede {
    margin: 0.5rem 0 2rem;
    color: #4a5a6e;
    font-size: 1.125rem;
  }

  .docs {
    max-width: 720px;
    margin-top: 4rem;
  }
  .docs :global(h2) {
    margin: 2.5rem 0 0.75rem;
    font-size: 1.5rem;
  }
  .docs :global(p) {
    margin: 0 0 1rem;
  }
  .docs :global(:not(pre) > code) {
    padding: 0.1em 0.35em;
    border-radius: 6px;
    background: rgb(9 32 59 / 0.07);
    font-size: 0.9em;
  }
  .docs :global(pre) {
    margin: 0 0 1.25rem;
    padding: 1rem 1.25rem;
    border-radius: 12px;
    overflow-x: auto;
    font-size: 0.875rem;
  }
</style>
