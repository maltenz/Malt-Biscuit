---
import BrandPalette from '../components/BrandPalette';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPage } from '../lib/content';

// Title, description, usage notes and documentation come from Tina
// (content/pages/brand.md); colour values come from the MUI theme.
const page = getPage('brand');
if (!page) {
  throw new Error('Missing content/pages/brand.md');
}
const { title, description, swatchNotes, Content } = page;
---

<BaseLayout title={`${title} · maltbiscuit`} description={description}>
  <main>
    <header>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
    </header>

    <BrandPalette notes={swatchNotes} client:load />

    <article class="docs prose">
      <Content />
    </article>
  </main>
</BaseLayout>

<style>
  main {
    max-width: 1120px;
    margin: 0 auto;
    padding: 2rem 1.5rem 5rem;
  }
  h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: -0.02em;
  }
  .lede {
    margin: 0.5rem 0 2rem;
    color: #525252;
    font-size: 1.125rem;
  }

  .docs {
    max-width: 720px;
    margin-top: 4rem;
  }
</style>
