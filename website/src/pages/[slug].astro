---
import Hero from '../components/Hero';
import PagePanel from '../components/PagePanel.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPages, type Page } from '../lib/content';

// Plain text pages (privacy, terms, …): any Tina page without its own route.
// Same full-page hero as the home page (the record shows the title and
// description), then the markdown body in a white panel.
export const prerender = true;

export function getStaticPaths() {
  // Pages with a dedicated route in src/pages. (Declared in here: Astro runs
  // getStaticPaths on its own, without the rest of the frontmatter.)
  const OWN_ROUTES = new Set(['home', 'brand']);
  return getPages()
    .filter((page) => !OWN_ROUTES.has(page.slug))
    .map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props as { page: Page };
const { title, description, Content } = page;
---

<BaseLayout title={`${title} · Malt Biscuit`} description={description} overlayNav>
  <main>
    <Hero title={title} description={description} profile={false} />
    <PagePanel>
      <div class="prose">
        <Content />
      </div>
    </PagePanel>
  </main>
</BaseLayout>

<style>
  .prose {
    max-width: 720px;
    margin-inline: auto;
  }
</style>
